# Supabase Dashboard → Connect → Transaction pooler(포트 6543) 연결 문자열
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# openssl rand -base64 32 등으로 생성한 긴 임의 문자열
CRON_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-secret

# 네이버 공지 원본 설정
NAVER_BLOG_ID=hyunjp88
NAVER_NOTICE_CATEGORY=공지사항
NAVER_NOTICE_CATEGORY_NO=33
